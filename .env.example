# Generate a fresh value: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
DATABASE_URL=sqlite:///./pricefinder.db
POSTGRES_PASSWORD=pricefinder-local-only
FIXTURE_MODE=true
CORS_ORIGINS=["http://localhost:3000"]
TOKEN_MINUTES=30
ALERT_INTERVAL_SECONDS=900

# Empty SMTP_HOST disables email alerts in local Python mode.
# Docker Compose defaults to the local Mailpit inbox, with no external email.
SMTP_HOST=
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=alerts@example.com

# Set these to enable browser Web Push. Keep the private key out of Git.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
